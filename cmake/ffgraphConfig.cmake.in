@PACKAGE_INIT@
set_and_check(_ffgraph_include_dir "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(_ffgraph_lib_dir "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(FFGRAPH_TK REQUIRED IMPORTED_TARGET tk>=8.6)
set(ffgraph_RELEASE_VERSION "@FFGRAPH_RELEASE_VERSION@")
set(_ffgraph_libraries)
foreach(_archive FFGraph FFGraphic FFlayout FFcontainer ffgraph_modern_gml ffgraph_modern_ff ffgraph_modern_rome)
  set_and_check(_path "${_ffgraph_lib_dir}/@CMAKE_STATIC_LIBRARY_PREFIX@${_archive}@CMAKE_STATIC_LIBRARY_SUFFIX@")
  list(APPEND _ffgraph_libraries "${_path}")
endforeach()
set(_ffgraph_dependencies PkgConfig::FFGRAPH_TK)
set(_ffgraph_definitions)
if("@WIN32@")
  list(APPEND _ffgraph_definitions NOMINMAX WIN32_LEAN_AND_MEAN FFGRAPH_NO_XPM)
else()
  find_dependency(X11)
  list(APPEND _ffgraph_dependencies X11::X11)
  if("@FFGRAPH_XPM@")
    find_library(FFGRAPH_XPM_LIBRARY NAMES Xpm REQUIRED)
    list(APPEND _ffgraph_dependencies "${FFGRAPH_XPM_LIBRARY}")
  else()
    list(APPEND _ffgraph_definitions FFGRAPH_NO_XPM)
  endif()
  foreach(_system_library m dl)
    find_library(FFGRAPH_${_system_library}_LIBRARY NAMES ${_system_library})
    if(FFGRAPH_${_system_library}_LIBRARY)
      list(APPEND _ffgraph_dependencies "${FFGRAPH_${_system_library}_LIBRARY}")
    endif()
  endforeach()
endif()
if(NOT TARGET ffgraph::ffgraph)
  list(JOIN _ffgraph_libraries "," _ffgraph_archive_group)
  add_library(ffgraph::ffgraph INTERFACE IMPORTED)
  set_target_properties(ffgraph::ffgraph PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_ffgraph_include_dir}"
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_COMPILE_DEFINITIONS "${_ffgraph_definitions}"
    INTERFACE_LINK_LIBRARIES "$<LINK_GROUP:RESCAN,${_ffgraph_archive_group}>;${_ffgraph_dependencies}")
endif()
check_required_components(ffgraph)
