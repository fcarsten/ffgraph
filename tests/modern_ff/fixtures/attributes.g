GRAPH "attributes" = DIRECTED
{$ FF_L "Probe" "graph payload" FF_L "Missing" "ignored"
FF_LO -2 3 FF_SC 150 FF_RX -25 FF_RY 200 FF_RZ 10
NP 1 2 12 "unused"; CUSTOM -1 "unknown" , $}
0 {$ NP -4 5 FF_3D 10 20 30 FF_C "blue" FF_R 9 SN EN
 FF_L "Probe" "node payload" FF_L "Missing" "ignored" FF_I "old icon" "old mask" FF_NI "icon" "selected icon"
 FF_NM "mask" "selected mask" UNKNOWN 9 "discarded" $} "zero"
 3 {$ EL 10 20 15 25 30 40 FF_3D 1 2 3 4 5 6
 FF_C "green" FF_WE 375 FF_L "Probe" "edge payload" FF_L "Missing" "ignored" CUSTOM -3 "discarded" $} "route";
3 {$ -10 -20 FF_I "single icon" FF_NI "new icon" FF_NM "new mask" $} "three";
END
