#  wm protocol . WM_DELETE_WINDOW { recall deleteWindow;}
  wm protocol . WM_DELETE_WINDOW { puts stderr "Use close";}
}

# initialize global variables
proc InitGlobals {} {
  global DefShape;
  set DefShape "Circle";
  global DefAnker;
  set DefAnker "Bottom";
  global {ffGrid}
  set {ffGrid} {0}
  global {splineFlag}
  set {splineFlag} {0}
  global {draging}
  set {draging} {0}
  global dragBoxX
  set dragBoxX 0
  global dragBoxY
  set dragBoxY 0
  global aktuCommand
  set aktuCommand recall
  global aktuCanvas
  set aktuCanvas .frame0.canvas2
  global oldAktuCanvas
  set oldAktuCanvas {}
  global workingMode
  set workingMode Create
  global {showLabelsFlag}
  set {showLabelsFlag} {1}
  global {showNodesFlag}
  set {showNodesFlag} {1}
  global {showEdgesFlag}
  set {showEdgesFlag} {1}

  global {isDirected}
  set isDirected(.frame0.canvas2) 1
  global {mousePressed}
  set {mousePressed} {0}
  global {Inspector}
  set {Inspector} {0}
  global {draging}
  set {draging} {0}
  global {xoff}
  set {xoff} {15}
  global {yoff}
  set {yoff} {15}
  global {symbolicName}
  set {symbolicName(graphView)} {.frame0.canvas2}
}

# initialize global variables
InitGlobals
EndSrc


