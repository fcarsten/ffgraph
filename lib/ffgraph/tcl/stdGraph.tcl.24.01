    -state active \
    -label {Top}
  .frame1.menubutton3.m.anker add radiobutton \
    -command {changeAnchor n; recall setNodePosition bottom} \
    -variable DefAnker \
    -state active \
    -label {Bottom}
  .frame1.menubutton3.m.anker add radiobutton \
    -command {changeAnchor center; recall setNodePosition Inside} \
    -variable DefAnker \
    -state active \
    -label {Inside}
  
  # build widget .frame1.menubutton6.m
