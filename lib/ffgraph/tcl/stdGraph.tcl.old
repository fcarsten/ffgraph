proc ffSetColorsForWin {w} {
  ##############
  # Procedure  : setColorsForWin
  # Description: sets the colors for the window "w" and all its child-windows
  # Arguments  : w: window
  # Returns    : none
  # Sideeffects: the author is not familiar to any strange sideeffects 
  #              (shit happens)
  # Author     : Achim Dannecker
  ##############
  
  $w configure -bg #dddddd
  set tmplist [winfo children $w]
  while {[llength $tmplist] != 0} {
    switch [winfo class [lindex $tmplist 0]] {
      Listbox {[lindex $tmplist 0] configure -bg #ebebeb\
		 -highlightthickness 0 \
		 -borderwidth 2 -relief ridge -selectmode browse
      }
      Scrollbar {[lindex $tmplist 0] configure -bg gold \
		   -activebackground #c6c6c6 \
		   -highlightthickness 0 \
		   -borderwidth 1 -relief ridge
      }
      Entry {[lindex $tmplist 0] configure -bg #ebebeb \
	       -highlightthickness 0 -bd 1
      }
      Checkbutton {[lindex $tmplist 0] configure -bg #ebebeb \
		     -activebackground #c6c6c6 \
		     -highlightthickness 0 \
		     -relief raised -bd 3 \
		     -padx 5 -pady 1
	bind [lindex $tmplist 0] <1> {
	  %W configure -relief sunken
	}
	bind [lindex $tmplist 0] <ButtonRelease> {
	  %W configure -relief raised
	}
      }
      Button {[lindex $tmplist 0] configure -bg #ebebeb \
		-activebackground #c6c6c6 \
		-highlightthickness 0 -relief raised -bd 2
      }
      Scale {[lindex $tmplist 0] configure -borderwidth 1 -relief ridge \
        -bg #ebebeb -fg #c6c6c6 -activebackground #c6c6c6 -relief raised -bd 1
      }
      default {[lindex $tmplist 0] configure -bg #ebebeb
      }
    }
    set tmplist [concat $tmplist [winfo children [lindex $tmplist 0]]]
    set tmplist [lreplace $tmplist 0 0]
  }
}

# Procedure: addStdText
proc addStdText { x y t} {
global symbolicName
return [addText [set symbolicName(graphView)] $x $y $t]
}

proc hideallLabels {} {
  global symbolicName
  global showLabelsFlag
  if { $showLabelsFlag == 1 } {
    showallLabels
  } {
    set canv $symbolicName(graphView)
    foreach i [$canv find withtag cfLabelText] {
      $canv itemconfigure $i -window {}
    }
  }
}
proc showallLabels {} {
  global symbolicName
  set canv $symbolicName(graphView)
  foreach i [$canv find withtag cfLabelText] {
    if { [ $canv.$i cget -text ] != "" } {
      $canv itemconfigure $i -window $canv.$i
    }
  }
}

# Procedure: addText
proc addText { canv x y t} {
  global showLabelsFlag
  set cfTmpTag [$canv create window [expr $x+5] $y]
  label $canv.$cfTmpTag -padx 2 -pady 2 -bd 0 -relief flat\
    -bg [$canv cget -bg] -fg black -text $t -anchor center
  $canv itemconfigure $cfTmpTag -anchor w

  if { ($t != "") && ($showLabelsFlag == 1) } {
    $canv itemconfigure $cfTmpTag -window $canv.$cfTmpTag
    set tmp [$canv bbox $cfTmpTag]
    set width [expr [lindex $tmp 2] - [lindex $tmp 0]]
    set height [expr [lindex $tmp 3] - [lindex $tmp 1]]
    $canv itemconfigure $cfTmpTag -width $width -height $height
  } {
    $canv.$cfTmpTag configure -padx 0 -pady 0
    $canv itemconfigure $cfTmpTag -width 0 -height 0
    $canv itemconfigure $cfTmpTag -window {}
  }
  
#     set cfTmpTag [$canv create text $x $y]
  $canv addtag cfLabelText withtag $cfTmpTag
  $canv raise $cfTmpTag all
#     $canv itemconfigure $cfTmpTag -anchor {w} -justify {left}\
#             -font -*-Courier-Bold-R-Normal--*-120-* -text $t
    
  return $cfTmpTag
}

