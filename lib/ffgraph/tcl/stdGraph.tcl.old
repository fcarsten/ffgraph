# Procedure: moveNode
proc moveNode { canv c x y r} {
  set nase [$canv gettags $c]
  if {[lsearch $nase windowNode] != -1} {
    $canv coords $c $x $y
    return
  }
  if {[lsearch $nase iconNode] != -1} {
    $canv coords $c $x $y
  } {
    $canv coords $c [expr ($x-$r)]  [expr ($y+$r)] \
      [expr ($x+$r)] [expr ($y-$r)] 
  }
}

