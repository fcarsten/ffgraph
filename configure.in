AC_INIT()
AC_CONFIG_HEADER(config.h)

dnl Checks for programs.
AC_PROG_CC
AC_PROG_CXX
AC_PROG_INSTALL
AC_PROG_RANLIB
dnl AC_PROG_YACC
dnl AC_PROG_LEX
dnl AC_PROG_AWK
AC_PROG_MAKE_SET
AC_PATH_PROG(BISONXX,bison++, echo)
AC_PATH_PROG(FLEXXX,flex++, echo)
dnl AC_PATH_PROG(BISON,bison)
dnl AC_PATH_PROG(FLEX,flex)
AC_PATH_PROG(PERL,perl)
dnl AC_PATH_PROG(TAR,tar)
AC_PATH_PROG(MV,mv)
AC_PATH_PROG(CP,cp)
AC_PATH_PROG(LATEX,latex)
AC_PATH_PROG(DVIPS,dvips)
AC_PATH_PROG(FIGTODEV,figtodev)
AC_PATH_PROG(BIBTEX,bibtex)

dnl Checks for libraries.
AC_CHECK_LIB(nsl, inet_addr)
AC_CHECK_LIB(socket, socket)
dnl AC_CHECK_LIB(rplay, rplay_open, , , -lsocket -lnsl)
dnl AC_CHECK_LIB(termcap, tputs)
dnl AC_CHECK_LIB(readline, readline, , , -ltermcap)
AC_CHECK_LIB(Xpm, XpmAttributesSize, , , -lX11)

dnl Checks for header files.
AC_HEADER_STDC
AC_CHECK_HEADERS(fcntl.h sys/time.h sys/file.h sys/ioctl.h unistd.h string.h stdlib.h libio.h sys/filio.h limits.h X11/xpm.h)
AC_HEADER_DIRENT
AC_HEADER_SYS_WAIT

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_C_INLINE
AC_TYPE_SIZE_T
dnl AC_HEADER_TIME
AC_STRUCT_TM
AC_TYPE_PID_T

dnl Checks for library functions.
AC_FUNC_ALLOCA
AC_PROG_GCC_TRADITIONAL
dnl AC_TYPE_SIGNAL
AC_CHECK_FUNCS(ftime socket strchr getrlimit)
AC_REPLACE_FUNCS(strdup)

dnl add pipe option 
if test $GCC = yes; then
  CFLAGS="$CFLAGS -pipe -Wall -Wno-unused"
fi
if test $GXX = yes; then
  CXXFLAGS="$CXXFLAGS -pipe -Wall -Wno-unused -Woverloaded-virtual -fno-implicit-templates"
fi

AC_OUTPUT(Makefile Makefile.head.common doc/Makefile contrib/shortinc include/ffgraph/ffGlobdefs.h)
