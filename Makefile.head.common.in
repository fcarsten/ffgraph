CC = @CC@
CCC = @CXX@
CPP = @CPP@
FLEX   = @LEX@
BISON  = @YACC@
FLEXXX = @FLEXXX@
BISONXX = @BISONXX@
RANLIB = @RANLIB@
TAR = @TAR@
GENCLASS = genclass
PREPEND = prepend
MV     = @MV@
CP     = @CP@

prefix = @prefix@
INSTALL = @INSTALL@
INSTALL_DIR = mkinstalldirs
INSTALL_DATA = @INSTALL_DATA@
INSTALL_PROGRAM = @INSTALL_PROGRAM@

bindir = $(prefix)/bin
libdir = $(prefix)/lib
includedir = $(prefix)/include/ffgraph
infodir = $(prefix)/info
mandir  = $(prefix)/man
runtimedir = $(prefix)/lib/ffgraph

CFLAGS = @CFLAGS@
CCFLAGS = @CXXFLAGS@
LDFLAGS	= @LDFLAGS@

INCLUDES = -I../include -Iinclude -I.. -I. $(shell pkg-config --cflags tk 2>/dev/null)
 
STD_INCLUDES = $(shell pkg-config --cflags tk 2>/dev/null)
