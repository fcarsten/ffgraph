%%BeginDocument: sugiInsp.eps


% remember original state
/origstate save def

% build a temporary dictionary
20 dict begin

% define string to hold a scanline's worth of data
/pix 194 string def

% define space for color conversions
/grays 194 string def  % space for gray scale line
/npixls 0 def
/rgbindx 0 def

% lower left corner
180 10 translate

% size of image (on paper, in 1/72inch coords)
193.96800 609.98400 scale

194 610 8			% dimensions of data
[194 0 0 -610 0 610]		% mapping matrix
{currentfile pix readhexstring pop}
